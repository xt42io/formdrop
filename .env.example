DATABASE_URL=postgresql://user:password@localhost:5432/formdrop

BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:1200

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


POLAR_ACCESS_TOKEN=...

POLAR_PRODUCT_ID=...

POLAR_WEBHOOK_SECRET=...

RESEND_API_KEY=re...

# PostHog (W6). Analytics stays off entirely when the key is absent, so this is
# optional for local work. Events are sent to /ingest on our own origin, which
# proxies to POSTHOG_API_HOST, so ad blockers cannot drop them.
VITE_POSTHOG_KEY=phc_...
POSTHOG_API_HOST=https://us.i.posthog.com
