# Copy to .env and fill in. Everything marked optional has a working
# no-op fallback, so a local checkout runs without it.

# ---------------------------------------------------------------- core

DATABASE_URL=postgresql://user:password@localhost:5432/formdrop

BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:1200

# Public origin of apps/web. Used to build the links inside emails --
# recipient verification and the "view in dashboard" button. Without it the
# notification email drops the button rather than linking to "undefined/app".
APP_URL=http://localhost:1200

# ---------------------------------------------------------------- auth

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ---------------------------------------------------------------- email (W7)

# Which adapter @formdrop/email sends through: resend | zeptomail | sendbyte.
# Defaults to resend. "sendbyte" throws on send until D3 lands -- its API
# contract has not been provided, and an adapter guessed at would fail on the
# real API rather than here.
EMAIL_PROVIDER=resend

# The sending address, and the name shown beside it.
EMAIL_FROM=noreply@mail.formdrop.co
EMAIL_FROM_NAME=FormDrop

# Whichever provider EMAIL_PROVIDER names needs its own key.
RESEND_API_KEY=re_...
ZEPTO_API_KEY=

# ---------------------------------------------------------------- billing

POLAR_ACCESS_TOKEN=...
POLAR_PRODUCT_ID=...
POLAR_PRODUCT_ID_YEARLY=...
POLAR_WEBHOOK_SECRET=...

# ---------------------------------------------------------------- integrations

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------- analytics (W6)

# Analytics stays off entirely when the key is absent, so this is optional for
# local work. Events go to /ingest on our own origin, which proxies to
# POSTHOG_API_HOST, so ad blockers cannot drop them.
#
# Two names for one project: Vite exposes VITE_*, Next exposes NEXT_PUBLIC_*.
# apps/api and apps/web's server code read VITE_POSTHOG_KEY.
VITE_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
POSTHOG_API_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------- ops

# Unhandled errors from apps/api. Off when unset.
SENTRY_DSN=

# The outbox worker runs in-process with the API by default. Set this to
# "off" for a deployment that drains the outbox from a separate process --
# the rows stay queued either way, so nothing is lost while it is off.
OUTBOX_WORKER=

# Where apps/web proxies /docs. Baked at build time, so changing it needs a
# rebuild of apps/web, not just a restart.
DOCS_ORIGIN=http://localhost:1300

# Optional feature flags.
VITE_FLAGSWIFT_CLIENT_API_KEY=

# ---------------------------------------------------------------- CI only
#
# Not read from .env -- these are GitHub Actions secrets.
#
#   NPM_TOKEN              publish-sdks.yml, to publish on tag
#   FORMDROP_STAGING_URL   the SDK contract job's target API
#   FORMDROP_STAGING_KEY   an API key on that staging account
#
# The contract suite skips itself when the last two are unset, so CI stays
# green until a staging environment exists.
