                              "null"
                            ]
                          },
                          "createdAt": {
                            "format": "date-time",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
