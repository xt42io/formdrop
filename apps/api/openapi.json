    "/v1/forms/{slug}/submissions": {
      "get": {
        "tags": [
          "Submissions"
        ],
        "summary": "List submissions",
        "description": "Cursor paginated, newest first. `limit` defaults to 50 and is capped at 200. Pass the previous response's `nextCursor` to continue; a null `nextCursor` means the last page.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 1,
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "nextCursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "formId",
                          "payload",
                          "ip",
                          "userAgent",
                          "createdAt"
                        ],
