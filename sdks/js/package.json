{
  "name": "@formdrop/js",
  "version": "0.1.0",
  "description": "The official FormDrop client. Zero dependencies, browser and Node.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "formdrop",
    "forms",
    "form-backend",
    "submissions"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "devDependencies": {
    "@formdrop/tsconfig": "*",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
